{
  "name": "dsh-comfyui-mcp",
  "version": "0.1.6",
  "description": "ComfyUI connection and safe on-demand lifecycle for DSH; powered by artokun/comfyui-mcp.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaczev/dsh-comfyui-mcp.git"
  },
  "homepage": "https://github.com/Kaczev/dsh-comfyui-mcp#readme",
  "bugs": {
    "url": "https://github.com/Kaczev/dsh-comfyui-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs",
    "lazy-tools.mjs",
    "runtime.mjs",
    "configured-runtime.mjs",
    "server.mjs",
    "client.js",
    "cordis.patch.yml",
    "assets/icon.svg",
    "assets/icon.png",
    "assets/icon-prompt.txt",
    "locale",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.mjs && node --check runtime.mjs && node --check configured-runtime.mjs && node --check server.mjs && node --check client.js && node --check lazy-tools.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "npm run check",
    "pack:check": "npm pack --dry-run --json"
  },
  "dependencies": {
    "comfyui-mcp": "0.52.206",
    "@modelcontextprotocol/sdk": "~1.32.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5"
  }
}
